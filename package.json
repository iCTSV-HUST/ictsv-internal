{
	"name": "ictsv-internal",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler pages dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "pnpm run build && wrangler pages deploy",
		"cf-typegen": "wrangler types && move worker-configuration.d.ts src/",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "tsx ./src/lib/server/db/migrate.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261013.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/papaparse": "^5.5.2",
		"daisyui": "^5.7.50",
		"drizzle-kit": "^0.31.11",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-confetti": "^2.3.2",
		"svelte-multiselect": "^11.8.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"wrangler": "^4.150.0"
	},
	"type": "module",
	"imports": {
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*.svelte.ts": "./src/lib/*.svelte.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"dependencies": {
		"@lucide/svelte": "^1.56.0",
		"@neondatabase/serverless": "^1.2.0",
		"bcryptjs": "^3.0.2",
		"dayjs": "^1.11.18",
		"dotenv": "^18.0.7",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.1.0",
		"js-confetti": "^0.13.0",
		"ol": "^10.11.0",
		"p-all": "^5.0.0",
		"papaparse": "^5.7.0",
		"svelte-french-toast": "2.0.0-alpha.0",
		"svelte-virtuallists": "^1.4.2",
		"zod": "^4.6.7"
	}
}
